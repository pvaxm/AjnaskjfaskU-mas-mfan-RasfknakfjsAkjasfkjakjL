local Signal = {}
Signal.__index = Signal

function Signal.new()
	return setmetatable({ _fns = {} }, Signal)
end

function Signal:Connect(fn)
	local fns = self._fns
	fns[#fns + 1] = fn
	return {
		Disconnect = function()
			for i = 1, #fns do
				if fns[i] == fn then
					table.remove(fns, i)
					break
				end
			end
		end,
	}
end

function Signal:Fire(...)
	local snapshot = {}
	for i = 1, #self._fns do snapshot[i] = self._fns[i] end
	for i = 1, #snapshot do
		task.spawn(snapshot[i], ...)
	end
end


end

local function NextSequence()
	Sequence += 1
	return Sequence
end

local function AlternateLimb()
	CurrentLimb = CurrentLimb == "RightHand" and "LeftHand" or "RightHand"
	return CurrentLimb
end

local function NearestTarget(MaxDistance)
	local Root = RootPart()
	if not Root then return nil, nil, math.huge end

	local ClosestModel, ClosestRoot, ClosestDist = nil, nil, MaxDistance or math.huge

	for _, Model in LiveFolder:GetChildren() do
		if Model:IsA("Model") and Model.Name ~= LocalPlayer.Name then
			local TargetHum = Model:FindFirstChildOfClass("Humanoid")
			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")

			if TargetHum and TargetRoot and TargetHum.Health > 0 then
				local Dist = (Root.Position - TargetRoot.Position).Magnitude
				if Dist < ClosestDist then
					ClosestModel = Model
					ClosestRoot = TargetRoot
					ClosestDist = Dist
				end
			end
		end
	end

	return ClosestModel, ClosestRoot, ClosestDist
end

local function TargetsInRange(Range)
	local Root = RootPart()
	if not Root then return {} end

	local Results = {}

	for _, Model in LiveFolder:GetChildren() do
		if Model:IsA("Model") and Model.Name ~= LocalPlayer.Name then
			local TargetHum = Model:FindFirstChildOfClass("Humanoid")
			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")

			if TargetHum and TargetRoot and TargetHum.Health > 0 then
				local Dist = (Root.Position - TargetRoot.Position).Magnitude
				if Dist <= Range then
					table.insert(Results, {
						Model = Model,
						Root = TargetRoot,
						Distance = Dist,
					})
				end
			end
		end
	end

	table.sort(Results, function(A, B)
		return A.Distance < B.Distance
	end)

	return Results
end


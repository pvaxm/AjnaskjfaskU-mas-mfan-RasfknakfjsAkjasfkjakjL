local function DisableWeaveGlide()
	if GlideConn then GlideConn:Disconnect(); GlideConn = nil end
	if GlideBody and GlideBody.Parent then GlideBody:Destroy() end
	GlideBody = nil
end

local function EnableWeaveGlide()
	DisableWeaveGlide()
	local Char = Character()
	if not Char then return end
	local Hum = Char:FindFirstChildOfClass("Humanoid")
	local Hrp = Char:FindFirstChild("HumanoidRootPart")
	if not Hum or not Hrp then return end
	local Bv = Instance.new("BodyVelocity")
	Bv.Name = "GlideVelocity"
	Bv.MaxForce = Vector3.new(1e4, 0, 1e4)
	Bv.Velocity = Vector3.zero
	Bv.P = 1e4
	Bv.Parent = Hrp
	GlideBody = Bv
	GlideConn = RunService.Heartbeat:Connect(function()
		if not Library.Flags.WeaveGlide or not Bv.Parent then
			DisableWeaveGlide()
			return
		end
		local SpaceHeld = UserInputService:IsKeyDown(Enum.KeyCode.Space)
		local DirHeld = UserInputService:IsKeyDown(Enum.KeyCode.W)
			or UserInputService:IsKeyDown(Enum.KeyCode.A)
			or UserInputService:IsKeyDown(Enum.KeyCode.S)
			or UserInputService:IsKeyDown(Enum.KeyCode.D)
		if SpaceHeld and DirHeld then
			local Md = Hum.MoveDirection
			Bv.MaxForce = Vector3.new(1e4, 0, 1e4)
			Bv.Velocity = Md.Magnitude > 0.1 and Md * (Library.Flags.GlideSpeed or 60) or Vector3.zero
		else
			Bv.MaxForce = Vector3.zero
		end
	end)
end

-- // keeps a teleport destination from ending inside or under the floor
local function ClampToGround(Pos, Root)
	local Params = RaycastParams.new()
	Params.FilterType = Enum.RaycastFilterType.Exclude
	Params.FilterDescendantsInstances = {LiveFolder, Character()}
	local Hit = workspace:Raycast(Pos + Vector3.new(0, 6, 0), Vector3.new(0, -60, 0), Params)
	if not Hit then return Pos end
	local Hum = Humanoid()
	local MinY = Hit.Position.Y + (Hum and Hum.HipHeight or 2) + Root.Size.Y / 2
	if Pos.Y < MinY then
		return Vector3.new(Pos.X, MinY, Pos.Z)
	end
	return Pos
end

local function TeleportTo(Pos)
	local Root = RootPart()
	if not Root then return end
	Pos = ClampToGround(Pos, Root)
	if ActiveTween then ActiveTween:Cancel() end
	local Dist = (Root.Position - Pos).Magnitude
	-- // ~30 studs/sec so the hypervisor doesn't flag it as a speed hack
	local Duration = math.clamp(Dist / 30, 0.1, 1.5)
	if not SavedGravity then
		SavedGravity = workspace.Gravity
	end
	workspace.Gravity = 0
	local Tween = TweenService:Create(Root, TweenInfo.new(Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), {
		CFrame = CFrame.new(Pos)
	})
	ActiveTween = Tween
	-- // a replacing tween cancels this one; only the latest tween restores gravity
	Tween.Completed:Connect(function()
		if ActiveTween == Tween then
			ActiveTween = nil
			RestoreGravity()
		end
	end)
	Tween:Play()
end

local function ExpandHitbox(Model, Scale)
	local Part = Model:FindFirstChild("HumanoidRootPart")
	if not Part then return end
	if not OriginalSizes[Part] then
		OriginalSizes[Part] = {Size = Part.Size, CanCollide = Part.CanCollide}
	end
	local Base = OriginalSizes[Part].Size
	local Side = math.max(Base.X, Base.Z) * Scale
	Part.Size = Vector3.new(Side, Base.Y * Scale, Side)
	Part.Transparency = (Library and Library.Flags and Library.Flags.HitboxVisualizer) and 0.7 or 1
	-- // never set Massless here: it demotes the HRP as assembly root and the character stops updating
	Part.CanCollide = false
	ExpandedHitboxes[Part] = true
end

local function ShrinkHitbox(Part)
	if OriginalSizes[Part] then
		Part.Size = OriginalSizes[Part].Size
		Part.Transparency = 1
		Part.CanCollide = OriginalSizes[Part].CanCollide
		OriginalSizes[Part] = nil
		ExpandedHitboxes[Part] = nil
	end
end

local function ShrinkAllHitboxes()
	for Part, _ in ExpandedHitboxes do
		if Part and Part.Parent then
			if OriginalSizes[Part] then
				Part.Size = OriginalSizes[Part].Size
				Part.Transparency = 1
				Part.CanCollide = OriginalSizes[Part].CanCollide
			end
		end
		OriginalSizes[Part] = nil
	end
	ExpandedHitboxes = {}
end


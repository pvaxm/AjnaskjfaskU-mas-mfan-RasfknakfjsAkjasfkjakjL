-- // Anti ragdoll: stand back up and undo the massless limbs the game sets while you are knocked
local RagdollStates = {
	[Enum.HumanoidStateType.Ragdoll] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
	[Enum.HumanoidStateType.Physics] = true,
}

local function UpdateAntiRagdoll()
	if not Library or not Library.Flags or not Library.Flags.AntiRagdoll then return end
	local Char = Character()
	local Hum = Humanoid()
	if not Char or not Hum or Hum.Health <= 0 then return end

	Hum:SetStateEnabled(Enum.HumanoidStateType.GettingUp, true)
	if Hum.PlatformStand then
		Hum.PlatformStand = false
	end
	if RagdollStates[Hum:GetState()] then
		Hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end
	for _, Part in Char:GetChildren() do
		if Part:IsA("BasePart") and Part ~= Char.PrimaryPart and Part.Massless then
			Part.Massless = false
		end
	end
end

local function UpdateNoClip()
	if not Library or not Library.Flags then return end
	if not Library.Flags.NoClip then return end

	local Char = Character()
	if not Char then return end
	for _, Part in Char:GetDescendants() do
		if Part:IsA("BasePart") then
			Part.CanCollide = false
		end
	end
end


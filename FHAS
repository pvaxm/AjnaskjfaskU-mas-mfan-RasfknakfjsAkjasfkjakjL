-- // Adonis Bypass
-- // timeout nukes frozen threads so Kill()'s `while true do end` cant softlock us
ScriptContext:SetTimeout(0.5)

local Nop = newcclosure(function() return end)
local BypassRan = false

do
	-- // dig the anti table out of gc
	local AntiTable
	for _, Value in getgc(true) do
		if type(Value) == "table" then
			local Det = rawget(Value, "Detected")
			local Lnc = rawget(Value, "Launch")
			local Add = rawget(Value, "AddDetector")
			if type(Det) == "function" and type(Lnc) == "function" and type(Add) == "function" then
				AntiTable = Value
				break
			end
		end
	end

	if not AntiTable then
		warn("[Aural] no adonis ac table in gc, game might not run it")
	else
		local OrigDetected = rawget(AntiTable, "Detected")
		local OrigLaunch = rawget(AntiTable, "Launch")
		local OrigAddDetector = rawget(AntiTable, "AddDetector")

		-- // snapshot debug info before hooks, tamper checks re-query these
		local DetectSrc, DetectLine, DetectName = debug.info(OrigDetected, "sln")

		-- // hookfunction swaps body at closure level, hits local captures too
		hookfunction(OrigDetected, Nop)
		hookfunction(OrigLaunch, Nop)
		hookfunction(OrigAddDetector, Nop)

		-- // backup: filtergc Detected by string constants
		pcall(function()
			local FgcDet = filtergc("function", {
				Constants = {" - On Xbox", " - On mobile", "_"},
				IgnoreExecutor = true,
			}, true)
			if FgcDet and type(FgcDet) == "function" and FgcDet ~= OrigDetected then
				hookfunction(FgcDet, Nop)
			end
		end)

		-- // spoof debug.info for original Detected ref
		local OldDebugInfo
		OldDebugInfo = hookfunction(debug.info, newcclosure(function(Fn, Opts, ...)
			if type(Fn) == "function" and Fn == OrigDetected and Opts then
				local Out = {}
				for Ch in string.gmatch(Opts, ".") do
					if Ch == "s" then table.insert(Out, DetectSrc)
					elseif Ch == "l" then table.insert(Out, DetectLine)
					elseif Ch == "n" then table.insert(Out, DetectName)
					elseif Ch == "a" then table.insert(Out, 0)
					elseif Ch == "f" then table.insert(Out, OrigDetected) end
				end
				return unpack(Out)
			end
			return OldDebugInfo(Fn, Opts, ...)
		end))

		-- // teleport-kicks: same placeid but different jobid = booting you
		local OldTpToPlace
		OldTpToPlace = hookfunction(TeleportService.TeleportToPlaceInstance, newcclosure(function(Self, PlaceId, JobId, Plr, ...)
			if Plr == LocalPlayer and PlaceId == game.PlaceId and JobId ~= game.JobId then
				return
			end
			return OldTpToPlace(Self, PlaceId, JobId, Plr, ...)
		end))

		pcall(function()
			local OldTp
			OldTp = hookfunction(TeleportService.Teleport, newcclosure(function(Self, PlaceId, Plr, ...)
				if (Plr == LocalPlayer or Plr == nil) and PlaceId == game.PlaceId then
					return
				end
				return OldTp(Self, PlaceId, Plr, ...)
			end))
		end)

		-- // hunt client.Disconnect and client.Kill in gc
		pcall(function()
			for _, Fn in getgc(true) do
				if type(Fn) == "function" then
					local Src = debug.info(Fn, "s")
					if Src and string.find(Src, "%.Client%.Core") then
						local Name = debug.info(Fn, "n")
						if Name == "Disconnect" or Name == "Kill" then
							hookfunction(Fn, Nop)
						end
					end
				end
			end
		end)

		-- // strip ac event listeners
		pcall(function()
			if not getconnections then return end
			local function StripAcConns(Signal)
				for _, Conn in getconnections(Signal) do
					if Conn.Function then
						local Src = debug.info(Conn.Function, "s")
						if Src and (string.find(Src, "Anti") or string.find(Src, "%.Client%.")) then
							Conn:Disable()
						end
					end
				end
			end
			StripAcConns(LogService.MessageOut)
			StripAcConns(ScriptContext.Error)
			StripAcConns(game.ChildAdded)
		end)

		-- // gcinfo alignment
		pcall(function()
			if gcinfo and collectgarbage then
				local RealGci = gcinfo
				local RealCgc = collectgarbage
				if RealGci() ~= RealCgc("count") then
					hookfunction(gcinfo, newcclosure(function()
						return RealCgc("count")
					end))
				end
			end
		end)

		-- // FindService at function ref level (ac grabs reference early)
		pcall(function()
			local Blocked = {
				VirtualUser = true,
				VirtualInputManager = true,
				UGCValidationService = true,
			}
			local OldFs
			OldFs = hookfunction(game.FindService, newcclosure(function(Self, Name, ...)
				if Blocked[Name] then return nil end
				return OldFs(Self, Name, ...)
			end))
		end)

		BypassRan = true
	end
end


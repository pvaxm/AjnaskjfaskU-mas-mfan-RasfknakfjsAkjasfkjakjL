-- // Local changers: the game reads your equipped Heavy / Takedown through DataController:Get on the client,
-- // so this only changes what you see and animate locally. The server keeps your real loadout.
local LocalChanger = {Overrides = {}}

pcall(function()
	LocalChanger.Data = require(ReplicatedStorage.Client.Controllers.DataController)
end)

function LocalChanger.Install()
	if not LocalChanger.Data or LocalChanger.OriginalGet then return end
	LocalChanger.OriginalGet = LocalChanger.Data.Get
	LocalChanger.Data.Get = function(Self, Key, ...)
		local Override = LocalChanger.Overrides[Key]
		if Override ~= nil then
			if os.clock() - (LocalChanger.LastRead or 0) > 1 then
				LocalChanger.LastRead = os.clock()
				Library:Notification({Name = Key, Description = "Game read " .. Key .. ": " .. Override, Icon = "check", Duration = 2})
			end
			return Override
		end
		return LocalChanger.OriginalGet(Self, Key, ...)
	end
end

function LocalChanger.Remove()
	if LocalChanger.Data and LocalChanger.OriginalGet then
		LocalChanger.Data.Get = LocalChanger.OriginalGet
		LocalChanger.OriginalGet = nil
	end
	table.clear(LocalChanger.Overrides)
end

function LocalChanger.Apply(Key, Value, FolderName)
	if type(Value) ~= "string" or Value == "" then
		Library:Notification({Name = Key, Description = "Pick one first.", Icon = "x", Duration = 3})
		return
	end
	if not LocalChanger.Data then
		Library:Notification({Name = Key, Description = "Could not reach the game's data module.", Icon = "x", Duration = 4})
		return
	end
	local Found = false
	pcall(function()
		local Folder = require(ReplicatedStorage.Shared.Config.Assets).CombatAnimations[FolderName]
		Found = Folder ~= nil and Folder:FindFirstChild(Value) ~= nil
	end)
	if not Found then
		local Names = {}
		pcall(function()
			for _, Child in require(ReplicatedStorage.Shared.Config.Assets).CombatAnimations[FolderName]:GetChildren() do
				table.insert(Names, Child.Name)
			end
		end)
		table.sort(Names)
		Library:Notification({Name = Key, Description = "No animation named " .. Value .. ". The game has: " .. table.concat(Names, ", "), Icon = "x", Duration = 10})
		return
	end
	LocalChanger.Install()
	LocalChanger.Overrides[Key] = Value
	Library:Notification({Name = Key, Description = "Local " .. string.lower(Key) .. " set to " .. Value .. ".", Icon = "check", Duration = 3})
end

function LocalChanger.Reset(Key)
	LocalChanger.Overrides[Key] = nil
	Library:Notification({Name = Key, Description = "Back to your real " .. string.lower(Key) .. ".", Icon = "check", Duration = 3})
end


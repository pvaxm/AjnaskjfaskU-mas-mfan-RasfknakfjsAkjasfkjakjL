-- // Library adapter
-- The window below is the AuralV2 UI from the hoopz script. The rest of this script still talks to it
-- through the small API it always used (Window:Tab, Tab:Section, Section:Toggle/Slider/Dropdown/Button,
-- Toggle:Keybind, Library.Flags.Name as plain values, Library:Notification), so nothing else had to change.
local HttpService = game:GetService("HttpService")
local lib = { Flags = {}, Unloaded = false }
local win = nil
local pending = nil -- a toggle waiting to see whether :Keybind() is called on it

local function flush()
	local Build = pending
	if Build then
		pending = nil
		Build()
	end
end

-- Library.Flags.Name returns the live value of the control with that Flag
setmetatable(lib.Flags, {
	__index = function(_, Key)
		flush()
		local Obj = win and win.Flags[Key]
		if Obj and Obj.Get then
			local Ok, Value = pcall(Obj.Get, Obj)
			if Ok then
				return Value
			end
		end
		return nil
	end,
})

local function newSection(Sec)
	local S = {}

	function S:Toggle(o)
		flush()
		o = o or {}
		local State = { Key = nil, Real = nil }
		local T = {}
		local function build()
			if State.Real then
				return State.Real
			end
			local Cfg = { Name = o.Name, Default = o.Default == true, Desc = o.Description, Flag = o.Flag, Callback = o.Callback }
			if State.Key then
				Cfg.Keybind = { Mode = State.Key.Mode or "Toggle", Default = State.Key.Default }
			end
			State.Real = Sec:AddToggle(Cfg)
			return State.Real
		end
		pending = build

		-- the key button has to exist when the row is built, so :Keybind() builds it right away
		function T:Keybind(K)
			if not State.Real then
				State.Key = K or {}
				flush()
			end
			return T
		end
		function T:Get()
			return build():Get()
		end
		function T:Set(Value, Silent)
			build():Set(Value, Silent)
		end
		T.Update = T.Set
		return T
	end

	function S:Slider(o)
		flush()
		o = o or {}
		local Real = Sec:AddSlider({
			Name = o.Name,
			Min = o.Min,
			Max = o.Max,
			Default = o.Default,
			Suffix = o.Suffix,
			Increment = o.Float or o.Step or o.Increment or 1,
			Flag = o.Flag,
			Desc = o.Description,
			Callback = o.Callback,
		})
		Real.Update = function(Self, Value, Silent) Self:Set(Value, Silent) end
		return Real
	end

	function S:Dropdown(o)
		flush()
		o = o or {}
		local Real = Sec:AddDropdown({
			Name = o.Name,
			Values = o.Options or o.Values,
			Default = o.Default,
			Multi = o.Multi or o.MultiSelect,
			Flag = o.Flag,
			Desc = o.Description,
			Callback = o.Callback,
		})
		Real.Update = function(Self, Value, Silent) Self:Set(Value, Silent) end
		return Real
	end

	function S:Button(o)
		flush()
		o = o or {}
		return Sec:AddButton({ Name = o.Name, Text = o.Name, Full = true, Desc = o.Description, Callback = o.Callback })
	end

	function S:Keybind(o)
		flush()
		o = o or {}
		return Sec:AddKeybind({ Name = o.Name, Default = o.Default, Mode = o.Mode or "None", Flag = o.Flag, Callback = o.Callback })
	end

	return S
end

local function newTab(Tab)
	local T = { _tab = Tab }
	function T:Section(o)
		flush()
		o = o or {}
		-- sections keep the column they had before: Left unless the script says Right
		return newSection(Tab:AddSection({ Title = o.Name or o.Title, Side = o.Side or "Left" }))
	end
	return T
end

function lib:Window(o)
	o = o or {}
	local Parent = nil
	pcall(function()
		Parent = (gethui and gethui()) or game:GetService("CoreGui")
	end)
	win = AuralV2.CreateWindow({
		Title = o.Title or o.Name or "Aural",
		Subtitle = o.Subtitle,
		Logo = o.Logo or AuralV2.LogoAsset,
		ToggleKey = o.ToggleKey or Enum.KeyCode.RightShift,
		Parent = Parent, -- same hidden place the old menu used
		GuiName = HttpService:GenerateGUID(false), -- random name, nothing in the game can look for it
		Blur = 0, -- no BlurEffect dropped into Lighting where the game could see it
		Configs = { Folder = "Aural/fias", AutoLoad = false },
	})
	task.delay(1, function()
		if win then
			pcall(function() win:LoadAutoConfig() end)
		end
	end)

	local W = {}
	function W:Tab(t)
		flush()
		t = t or {}
		return newTab(win:AddTab({ Name = t.Name, Icon = t.Icon }))
	end
	function W:SetToggleKey(Key)
		if Key and win then
			win:SetToggleKey(Key)
		end
	end
	function W:AddConfigs(TabProxy)
		flush()
		if win and TabProxy then
			pcall(function() win:AddConfigSections(TabProxy._tab) end)
		end
	end
	return W
end

function lib:Notification(o)
	flush()
	if not win then
		return
	end
	o = o or {}
	local Icon = tostring(o.Icon or "")
	local Kind = "info"
	if Icon == "check" then
		Kind = "success"
	elseif Icon == "x" then
		Kind = "error"
	elseif Icon == "alert-triangle" then
		Kind = "warning"
	end
	pcall(function()
		win:Notify({ Title = o.Name, Text = o.Description, Type = Kind, Duration = o.Duration })
	end)
end

function lib:Destroy()
	lib.Unloaded = true
	if win then
		pcall(function() win:Destroy() end)
		win = nil
	end
end

return lib

end)()


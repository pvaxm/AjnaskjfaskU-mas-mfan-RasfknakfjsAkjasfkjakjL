local function EquipFists()
	local Char = Character()
	if not Char or Char:FindFirstChild("Fight") then return end
	local FightTool = LocalPlayer.Backpack:FindFirstChild("Fight")
	if not FightTool then return end
	local Hum = Humanoid()
	if Hum and Hum.Health > 0 then
		Hum:EquipTool(FightTool)
	end
end

local function UpdateAutoKill()
	if not Library or not Library.Flags then return end
	if not Library.Flags.AutoKill or Library.Flags.KillAura or Library.Flags.AutoFarm then return end
	if not Alive() then return end
	EquipFists()

	local Now = tick()
	if Now - LastSwingTick < SwingInterval then return end

	local Range = Library.Flags.AutoKillRange or 15
	local TargetModel, TargetRoot, Dist = NearestTarget(Range)
	if not TargetRoot then return end

	-- tp behind the target if enabled
	if Library.Flags.AutoKillTP then
		local Offset = Library.Flags.AutoKillTPOffset or 3
		local BehindPos = TargetRoot.CFrame * CFrame.new(0, 0, Offset)
		TeleportTo(BehindPos.Position)
	end

	local HitPart = GetHitPart(TargetModel, Library.Flags.AutoKillPart or "HumanoidRootPart")
	if not HitPart then return end

	LastSwingTick = Now
	local Limb = GetLimb()
	local Seq = FireSwing("Attack", Limb)
	FireHitReport(Seq, HitPart, HitPart.Position)
end

local function UpdateKillAura()
	if not Library or not Library.Flags then return end
	if not Library.Flags.KillAura then return end
	if not Alive() then return end

	local Now = tick()
	if Now - LastSwingTick < SwingInterval then return end

	local Range = Library.Flags.AuraRange or 20
	local MaxTargets = Library.Flags.AuraMaxTargets or 5
	local Targets = TargetsInRange(Range)
	if #Targets == 0 then return end

	LastSwingTick = Now
	local Limb = GetLimb()
	local Seq = FireSwing("Attack", Limb)

	local Count = 0
	for _, Target in Targets do
		if Count >= MaxTargets then break end
		local HitPart = Target.Root
		if HitPart then
			Count += 1
			if Count == 1 then
				FireHitReport(Seq, HitPart, HitPart.Position)
			else
				task.delay(0.025 * (Count - 1), function()
					if HitPart.Parent then
						FireHitReport(Seq, HitPart, HitPart.Position)
					end
				end)
			end
		end
	end
end

local function UpdateAutoFarm()
	if not Library or not Library.Flags then return end
	if not Library.Flags.AutoFarm then return end
	if not Alive() then return end
	EquipFists()

	local Now = tick()
	if Now - LastSwingTick < SwingInterval then return end

	local Range = Library.Flags.FarmRange or 9999
	local TargetModel, TargetRoot, Dist = NearestTarget(Range)
	if not TargetRoot then return end

	-- tp underneath the target if enabled
	if Library.Flags.AutoFarmTP then
		local UnderPos = TargetRoot.Position - Vector3.new(0, 3, 0)
		TeleportTo(UnderPos)
	end

	local HitPart = TargetRoot
	LastSwingTick = Now
	local Limb = GetLimb()
	local Seq = FireSwing("Attack", Limb)
	FireHitReport(Seq, HitPart, HitPart.Position)
end

-- // Clears every expanded hitbox and forgets stale ones, so the next tick starts from a clean state
local function ResetHitboxes()
	ShrinkAllHitboxes()
	table.clear(OriginalSizes)
	table.clear(ExpandedHitboxes)
end

local function UpdateHitboxExpand()
	if not Library or not Library.Flags then return end
	if not Library.Flags.HitboxExpand then return end

	-- the Live folder can be rebuilt around a respawn, so do not keep using a dead one
	if not LiveFolder or LiveFolder.Parent ~= workspace then
		LiveFolder = workspace:FindFirstChild("Live") or LiveFolder
	end

	-- forget parts that no longer exist (players who died or left), so they cannot block a fresh expand
	for Part in ExpandedHitboxes do
		if not Part.Parent or not Part:IsDescendantOf(LiveFolder) then
			OriginalSizes[Part] = nil
			ExpandedHitboxes[Part] = nil
		end
	end

	local Scale = Library.Flags.HitboxScale or 5
	local Range = Library.Flags.HitboxRange or 30
	local Root = RootPart()
	if not Root then return end

	for _, Model in LiveFolder:GetChildren() do
		if Model:IsA("Model") and Model.Name ~= LocalPlayer.Name then
			local TRoot = Model:FindFirstChild("HumanoidRootPart")
			local THum = Model:FindFirstChildOfClass("Humanoid")
			if TRoot and THum and THum.Health > 0 then
				local Dist = (Root.Position - TRoot.Position).Magnitude
				if Dist <= Range then
					ExpandHitbox(Model, Scale)
				else
					ShrinkHitbox(TRoot)
				end
			end
		end
	end
end

local function UpdatePunchSpeed()
	if not Library or not Library.Flags then return end
	if not Library.Flags.PunchSpeed and not Library.Flags.SlamSpeed then return end

	local Char = Character()
	if not Char then return end
	local Hum = Char:FindFirstChildOfClass("Humanoid")
	if not Hum then return end
	local Anim = Hum:FindFirstChildOfClass("Animator")
	if not Anim then return end

	local PunchMult = Library.Flags.PunchSpeed and (Library.Flags.PunchSpeedMult or 2) or nil
	local SlamMult = Library.Flags.SlamSpeed and (Library.Flags.SlamSpeedMult or 2) or nil

	for _, Track in ipairs(Anim:GetPlayingAnimationTracks()) do
		if not Track.Looped then
			-- // slam toggle overrides Action4 tracks; everything else non-looped uses the punch multiplier
			local Mult = PunchMult
			if SlamMult and Track.Priority == Enum.AnimationPriority.Action4 then
				Mult = SlamMult
			end
			if Mult and math.abs(Track.Speed - Mult) > 0.01 then
				Track:AdjustSpeed(Mult)
			end
		end
	end
end


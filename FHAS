-- // Reapplies whichever of Heavy Attack, Aura and Fighting Style have their own "Auto equip on respawn"
-- // toggle on: the aura's clones and the Style attribute both live on the character model (lost on
-- // reset), and re-arming the Heavy override here costs nothing if it's already set
local function ReapplyLoadout()
	if not Library or not Library.Flags then return end
	local Char = Character()
	if not Char then return end

	if Library.Flags.StyleAutoEquip then
		local Style = Library.Flags.StyleChanger
		if type(Style) == "string" and Style ~= "" then
			pcall(function() Char:SetAttribute("Style", Style) end)
		end
	end

	if Library.Flags.AuraAutoEquip then
		local Aura = Library.Flags.AuraChanger
		if type(Aura) == "string" and Aura ~= "" and Aura ~= "None" then
			pcall(ApplyLocalAura, Aura)
		end
	end

	if Library.Flags.HeavyAutoEquip then
		local Heavy = Library.Flags.HeavyChoice
		if type(Heavy) == "string" and Heavy ~= "" and LocalChanger.Data then
			LocalChanger.Install()
			LocalChanger.Overrides["Heavy"] = Heavy
		end
	end
end

-- // Namecall Hook (bypass + features combined)
local OldNamecall
OldNamecall = hookmetamethod(game, "__namecall", newcclosure(function(Self, ...)
	local Method = getnamecallmethod()

	-- // bypass: eat kicks aimed at us
	if Method == "Kick" and typeof(Self) == "Instance" and Self:IsA("Player") and Self == LocalPlayer then
		return
	end

	-- // bypass: hide disallowed services from FindService
	if Method == "FindService" and Self == game then
		local Svc = select(1, ...)
		if Svc == "VirtualUser" or Svc == "VirtualInputManager" or Svc == "UGCValidationService" then
			return nil
		end
	end

	-- // no fall damage: block fall-down and ragdoll states (your humanoid only, never other players')
	if Method == "ChangeState" and typeof(Self) == "Instance" and Self:IsA("Humanoid") and Self == Humanoid() and Library and Library.Flags and Library.Flags.AntiRagdoll then
		local State = select(1, ...)
		if State == Enum.HumanoidStateType.FallingDown or State == Enum.HumanoidStateType.Ragdoll then
			return
		end
	end

	-- // anti ragdoll: the game turns GettingUp off while you are knocked, keep it on
	if Method == "SetStateEnabled" and typeof(Self) == "Instance" and Self:IsA("Humanoid") and Self == Humanoid() and Library and Library.Flags and Library.Flags.AntiRagdoll then
		local State, On = select(1, ...)
		if State == Enum.HumanoidStateType.GettingUp and On == false then
			return
		end
	end

	-- // silent aim: redirect HitReport to nearest enemy
	if Method == "FireServer" and Self == HitReportRemote and Library and Library.Flags and Library.Flags.SilentAim then
		local Args = {...}
		local AimRange = Library.Flags.SilentAimRange or 20
		local AimPart = Library.Flags.SilentAimPart or "HumanoidRootPart"
		local TargetModel, TargetRoot = NearestTarget(AimRange)
		if TargetModel then
			local RedirectPart = GetHitPart(TargetModel, AimPart)
			if RedirectPart then
				Args[2] = RedirectPart
				Args[3] = RedirectPart.Position
				return OldNamecall(Self, unpack(Args))
			end
		end
	end

	return OldNamecall(Self, ...)
end))

-- // ESP update
local TargetColorMap = {
	Red = Color3.fromRGB(255, 50, 50),
	Yellow = Color3.fromRGB(255, 220, 50),
	Cyan = Color3.fromRGB(50, 220, 255),
	Magenta = Color3.fromRGB(255, 50, 200),
}

local function UpdateESP()
	if not Library or not Library.Flags then return end
	if not Library.Flags.PlayerESP and not Library.Flags.TargetHighlight then
		for Model, Hl in ESPHighlights do
			Hl:Destroy()
		end
		table.clear(ESPHighlights)
		return
	end

	local Root = RootPart()
	if not Root then return end

	local MaxDist = Library.Flags.ESPDistance or 200
	local FillAlpha = Library.Flags.ESPFillAlpha or 0.7
	local EspOn = Library.Flags.PlayerESP
	local TargetOn = Library.Flags.TargetHighlight
	local TCol = TargetColorMap[Library.Flags.TargetColor or "Red"] or TargetColorMap.Red

	local Seen = {}

	for _, Model in LiveFolder:GetChildren() do
		if Model:IsA("Model") and Model.Name ~= LocalPlayer.Name then
			local TargetHum = Model:FindFirstChildOfClass("Humanoid")
			local TargetRoot = Model:FindFirstChild("HumanoidRootPart")

			if TargetHum and TargetRoot and TargetHum.Health > 0 then
				local Dist = (Root.Position - TargetRoot.Position).Magnitude
				if Dist <= MaxDist then
					Seen[Model] = true
					local Hl = ESPHighlights[Model]
					if not Hl or not Hl.Parent then
						Hl = Instance.new("Highlight")
						Hl.Name = "AuralESP"
						Hl.Parent = Model
						ESPHighlights[Model] = Hl
					end

					if EspOn then
						local Frac = TargetHum.Health / TargetHum.MaxHealth
						Hl.FillColor = Color3.fromHSV(Frac * 0.33, 1, 1)
						Hl.OutlineColor = Color3.new(1, 1, 1)
						Hl.FillTransparency = FillAlpha
						Hl.OutlineTransparency = 0
						Hl.Enabled = true
					elseif TargetOn and AutoFarmTarget and Model == AutoFarmTarget then
						Hl.FillColor = TCol
						Hl.OutlineColor = TCol
						Hl.FillTransparency = 0.5
						Hl.OutlineTransparency = 0
						Hl.Enabled = true
					else
						Hl.Enabled = false
					end
				end
			end
		end
	end

	for Model, Hl in ESPHighlights do
		if not Seen[Model] then
			Hl:Destroy()
			ESPHighlights[Model] = nil
		end
	end
end

-- // Auto Weave
local function UpdateAutoWeave()
	if not Library or not Library.Flags then return end
	if not Library.Flags.AutoWeave then return end
	if not Alive() then
		if WeaveActive then
			WeaveActive = false
			pcall(function() WeaveRemote:FireServer(false) end)
		end
		return
	end

	local Now = tick()
	local Interval = Library.Flags.WeaveInterval or 0.35
	if Now - LastWeaveTick < Interval then return end

	local Range = 20
	local _, TargetRoot = NearestTarget(Range)
	local ShouldWeave = TargetRoot ~= nil

	if ShouldWeave and not WeaveActive then
		WeaveActive = true
		LastWeaveTick = Now
		WeaveRemote:FireServer(true)
	elseif not ShouldWeave and WeaveActive then
		WeaveActive = false
		LastWeaveTick = Now
		WeaveRemote:FireServer(false)
	end
end

-- // Auto Struggle Win
local function UpdateAutoStruggle()
	if not Library or not Library.Flags then return end
	if not Library.Flags.AutoStruggle then return end
	if not InStruggle then return end

	local Now = tick()
	local CPS = Library.Flags.StruggleCPS or 12
	local BaseInterval = 1 / CPS

	local Jitter = 0
	if Library.Flags.StruggleJitter then
		Jitter = (math.random() - 0.5) * 0.03
	end

	if Now - LastStruggleTick < (BaseInterval + Jitter) then return end

	LastStruggleTick = Now
	StruggleRemote:FireServer()
end

